# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin secrets - never expose these to the browser and never commit real values.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Midtrans Snap payments
# Defaults safely to Sandbox unless explicitly set to true. Do not derive payment mode from NODE_ENV.
MIDTRANS_IS_PRODUCTION=false
# Server-only Midtrans key. Never prefix this with NEXT_PUBLIC_ and never commit real credentials.
MIDTRANS_SERVER_KEY=
# Public Client Key used by Snap.js in the browser. Sandbox and Production use different keys.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Merchant ID for webhook/status validation and operations traceability.
MIDTRANS_MERCHANT_ID=
# Deployed HTTPS application URL used for Snap finish callbacks and webhook setup.
NEXT_PUBLIC_APP_URL=
# Production must never use Sandbox credentials; configure separate Midtrans Production keys in Vercel.
