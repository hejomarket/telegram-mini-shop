# Public Supabase URL for browser-safe client metadata.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only Supabase service role key. Never expose this to the client and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only admin credentials. Never commit real values.
ADMIN_EMAIL=
# Generate with: npm run admin:hash-password -- "your-long-password". Do not use or commit plaintext passwords.
ADMIN_PASSWORD_HASH=
# Use a long random value, for example from: openssl rand -base64 48
ADMIN_SESSION_SECRET=
